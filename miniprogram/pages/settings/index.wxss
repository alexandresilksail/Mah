.settings { padding-top: 48rpx; }
.settings-title { font-size: 52rpx; font-weight: 900; color: #4A3524; margin-bottom: 36rpx; }
.group { padding: 8rpx 32rpx; margin-bottom: 32rpx; }
.row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 28rpx 0; border-bottom: 2rpx solid rgba(150,112,70,0.10);
}
.row:last-child { border-bottom: none; }
.row-label { display: flex; flex-direction: column; }
.row-name { font-size: 30rpx; font-weight: 600; color: #4A3524; }
.row-desc { font-size: 22rpx; color: #8B7154; margin-top: 6rpx; }
.row-badge { font-size: 22rpx; color: #A97520; background: #FFF5E2; padding: 8rpx 18rpx; border-radius: 999rpx; }
.rule { font-size: 26rpx; color: #6B5238; line-height: 1.9; padding: 8rpx 0 28rpx; }
.about .row { padding: 22rpx 0; }
.v { font-size: 28rpx; color: #6B5238; }
.reset-btn { width: 100%; margin-top: 16rpx; color: #D9533B; }
