{
  "name": "mah-le-mah",
  "private": true,
  "version": "2.0.0",
  "description": "MahLeMah v2.0.0 - 16 tile types / two rebuilt levels / six-robot difficulty model",
  "type": "module",
  "scripts": {
    "icons": "python tools/gen_icon.py",
    "build:web": "node tools/build_web.mjs",
    "build:legacy": "node tools/build_legacy.mjs",
    "build:all": "npm run build:web && npm run build:legacy",
    "build:portable": "node tools/build_portable.mjs",
    "build:nsis": "node tools/build_nsis.mjs",
    "build": "npm run build:portable && npm run build:nsis",
    "release": "python tools/make_release.py",
    "test": "node test.js && node tools/test_render.mjs",
    "test:random": "node test-random-generation.js",
    "test:build": "node test-build-consistency.js",
    "test:browser": "node tools/browser_smoke.mjs",
    "test:all": "node test.js && node tools/test_render.mjs && node test-random-generation.js && node test-build-consistency.js",
    "test:sim": "node test.js",
    "test:release": "node tools/stress_release.mjs",
    "tune": "node tools/tune.mjs",
    "tune:pool": "node tools/tune_pool.mjs",
    "dev": "tauri dev",
    "tauri": "tauri",
    "build:desktop": "tauri build"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@babel/preset-env": "^8.0.7",
    "@tauri-apps/cli": "^2.1.0",
    "acorn": "^8.19.0",
    "esbuild": "^0.28.2"
  }
}
